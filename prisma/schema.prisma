// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
  @@index([key])
}

model Website {
  id          Int      @id @default(autoincrement())
  title       String
  url         String   @unique
  description String
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int
  thumbnail   String?
  thumbnail_base64 String?
  status      String   @default("pending")
  visits      Int      @default(0)
  likes       Int      @default(0)
  active      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("websites")
  @@index([category_id])
  @@index([status])
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  websites   Website[]

  @@map("categories")
  @@index([slug])
}

model FooterLink {
  id         Int      @id @default(autoincrement())
  title      String   // 链接标题
  url        String   @unique // 链接地址
  isExternal Boolean  @default(true) // 是否为外部链接
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("footer_links")
  @@index([url])
}

// IPD流程阶段（顶层）
model IPDPhase {
  id         Int        @id @default(autoincrement())
  name       String     // IPD流程、需求分析、设计、开发&测试、发布&部署
  slug       String     @unique
  order_num  Int        // 排序序号
  color      String?    // 阶段颜色
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  stages     IPDStage[]

  @@map("ipd_phases")
  @@index([slug])
  @@index([order_num])
}

// IPD具体阶段项
model IPDStage {
  id           Int          @id @default(autoincrement())
  name         String       // 需求调研、架构设计、代码编写等
  phase        IPDPhase     @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  phase_id     Int
  order_num    Int          // 排序序号
  bg_color     String?      // 背景色（如：light_yellow, light_green, navy等）
  is_important Boolean      @default(false) // 是否标记重要（显示红星）
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  websites     IPDWebsite[]

  @@map("ipd_stages")
  @@index([phase_id])
  @@index([order_num])
}

// IPD阶段关联的网站
model IPDWebsite {
  id          Int      @id @default(autoincrement())
  title       String   // 网站名称
  url         String   // 网站地址
  description String?  // 网站描述
  stage       IPDStage @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  stage_id    Int
  order_num   Int      @default(0) // 排序序号
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("ipd_websites")
  @@index([stage_id])
  @@index([order_num])
}